{
  "facts": {
    "bd6de0960795250c": {
      "count": 1,
      "topic": "Whales",
      "text": "Whale poop helps fertilize the ocean and feeds tiny plankton.",
      "last_used": "2026-10-28T23:53:40.266726+00:00"
    },
    "9720cf7e5d665a6e": {
      "count": 1,
      "topic": "Cats",
      "text": "Cats can see in light that is about six times dimmer than what humans need.",
      "last_used": "2026-10-28T23:53:40.266767+00:00"
    },
    "ba1ad2c985a16d53": {
      "count": 1,
      "topic": "Elephants",
      "text": "Elephants can recognize themselves in a mirror, which shows they are self-aware.",
      "last_used": "2026-10-28T23:53:40.266786+00:00"
    },
    "8385e6687bab91b1": {
      "count": 1,
      "topic": "Space",
      "text": "A day on Venus is longer than a year on Venus.",
      "last_used": "2026-10-30T13:48:21.812721+00:00"
    },
    "c33f2e11dc0343fc": {
      "count": 1,
      "topic": "Cats",
      "text": "Adult cats rarely meow at each other. They mostly meow to talk to humans.",
      "last_used": "2026-10-30T13:48:21.812758+00:00"
    },
    "ce676900f40fc0a9": {
      "count": 1,
      "topic": "Wolves",
      "text": "An adult wolf has forty-two teeth.",
      "last_used": "2026-10-30T13:48:21.812772+00:00"
    },
    "605b4cc92d57b0f2": {
      "count": 1,
      "topic": "Elephants",
      "text": "Elephants can feel low rumbles from far away through the ground with their feet.",
      "last_used": "2026-10-30T20:04:08.753619+00:00"
    },
    "f843a3e98bc7a5e6": {
      "count": 1,
      "topic": "Space",
      "text": "Footprints on the Moon can last for millions of years.",
      "last_used": "2026-10-30T20:04:08.753651+00:00"
    },
    "03bebb6098c2a49a": {
      "count": 1,
      "topic": "Cats",
      "text": "Cats sleep for about twelve to sixteen hours every single day.",
      "last_used": "2026-10-30T20:04:08.753666+00:00"
    },
    "53ac0f9da5d74a9b": {
      "count": 1,
      "topic": "Whales",
      "text": "Cuvier's beaked whale holds the record for the deepest dive of any mammal, at nearly three thousand meters.",
      "last_used": "2026-10-31T09:57:51.197760+00:00"
    },
    "43a4eb33a818b096": {
      "count": 1,
      "topic": "Elephants",
      "text": "An elephant's trunk has tens of thousands of muscles, so it can lift a log or pick up a single peanut.",
      "last_used": "2026-10-31T09:57:51.197792+00:00"
    },
    "8b28179a9bf87dd8": {
      "count": 1,
      "topic": "Space",
      "text": "Sunlight takes about eight minutes to reach the Earth.",
      "last_used": "2026-10-31T09:57:51.197801+00:00"
    },
    "04f9c894acfbf174": {
      "count": 1,
      "topic": "Wolves",
      "text": "Wolves were brought back to Yellowstone National Park in nineteen ninety-five, and they changed the whole ecosystem.",
      "last_used": "2026-10-31T15:32:08.498342+00:00"
    },
    "7faa64517d42c583": {
      "count": 1,
      "topic": "Cats",
      "text": "Cats spend up to a third of their waking hours grooming themselves.",
      "last_used": "2026-10-31T15:32:08.498372+00:00"
    },
    "32a164c0f69f6bb6": {
      "count": 1,
      "topic": "Whales",
      "text": "The long tusk of a narwhal is actually a tooth that grows through its lip.",
      "last_used": "2026-10-31T15:32:08.498383+00:00"
    },
    "8836b86386a0ee9e": {
      "count": 1,
      "topic": "Whales",
      "text": "Humpback whales sometimes blow a spiral net of bubbles to trap fish before they feed.",
      "last_used": "2026-10-31T19:29:26.627341+00:00"
    },
    "9cee2e1d1a5618c5": {
      "count": 1,
      "topic": "Elephants",
      "text": "The African elephant is the largest land animal on Earth.",
      "last_used": "2026-10-31T19:29:26.627373+00:00"
    },
    "c0851d57f60c1a30": {
      "count": 1,
      "topic": "Cats",
      "text": "Adult cats have around two hundred and thirty bones, while humans have only two hundred and six.",
      "last_used": "2026-10-31T19:29:26.627389+00:00"
    },
    "99e272ae2374e677": {
      "count": 1,
      "topic": "Whales",
      "text": "The blue whale is the largest animal known to have ever lived on Earth.",
      "last_used": "2026-11-01T10:50:09.877075+00:00"
    },
    "9130c82b0860d03f": {
      "count": 1,
      "topic": "Elephants",
      "text": "An elephant's tusks are actually very long front teeth.",
      "last_used": "2026-11-01T10:50:09.877113+00:00"
    },
    "7b3bebfa464b19ae": {
      "count": 1,
      "topic": "Wolves",
      "text": "Wolves can run at about thirty-five miles per hour for short distances.",
      "last_used": "2026-11-01T10:50:09.877130+00:00"
    },
    "b7c52a227577a5ad": {
      "count": 1,
      "topic": "Cats",
      "text": "Cats have a third eyelid that helps protect and moisten their eyes.",
      "last_used": "2026-11-01T16:18:59.905171+00:00"
    },
    "feadb75ace19c5ff": {
      "count": 1,
      "topic": "Wolves",
      "text": "In open land, a wolf's howl can be heard from about six miles away.",
      "last_used": "2026-11-01T16:18:59.905201+00:00"
    },
    "5c43962eb936105f": {
      "count": 1,
      "topic": "Elephants",
      "text": "Wild elephants sleep only about two to four hours a day.",
      "last_used": "2026-11-01T16:18:59.905216+00:00"
    },
    "af1ddcbc1a3c300c": {
      "count": 1,
      "topic": "Elephants",
      "text": "An elephant has the largest brain of any land animal.",
      "last_used": "2026-11-01T19:56:09.852956+00:00"
    },
    "614d6e06d87af131": {
      "count": 1,
      "topic": "Whales",
      "text": "Whales are mammals, so they breathe air and feed their calves with milk.",
      "last_used": "2026-11-01T19:56:09.852992+00:00"
    },
    "67d2747dc425136a": {
      "count": 1,
      "topic": "Cats",
      "text": "Cats can jump up to five or six times their own body length.",
      "last_used": "2026-11-01T19:56:09.853007+00:00"
    },
    "589dc341667214b7": {
      "count": 1,
      "topic": "Wolves",
      "text": "Wolves have a sense of smell far better than humans.",
      "last_used": "2026-11-02T11:39:42.115373+00:00"
    },
    "b047c7aa8c70fc3f": {
      "count": 1,
      "topic": "Cats",
      "text": "Each cat ear has about thirty-two muscles, so it can rotate to catch tiny sounds.",
      "last_used": "2026-11-02T11:39:42.115408+00:00"
    },
    "308662ff2beb0b4f": {
      "count": 1,
      "topic": "Elephants",
      "text": "Elephants are pregnant for about twenty-two months, the longest pregnancy of any land mammal.",
      "last_used": "2026-11-02T11:39:42.115420+00:00"
    },
    "a7cf7da0236c7044": {
      "count": 1,
      "topic": "Whales",
      "text": "Sperm whales have the largest brain of any animal on the planet.",
      "last_used": "2026-11-02T19:46:51.020026+00:00"
    },
    "75e98a586366af49": {
      "count": 1,
      "topic": "Elephants",
      "text": "Elephants flap their huge ears to cool down their blood in the hot sun.",
      "last_used": "2026-11-02T19:46:51.020076+00:00"
    },
    "0a58aba3dc5b15e4": {
      "count": 1,
      "topic": "Wolves",
      "text": "All pet dogs descended from ancient wolves.",
      "last_used": "2026-11-02T19:46:51.020092+00:00"
    },
    "2ab4406b2ea7f039": {
      "count": 1,
      "topic": "Whales",
      "text": "Gray whales migrate more than ten thousand miles every year, one of the longest journeys of any mammal.",
      "last_used": "2026-11-02T23:14:50.184011+00:00"
    },
    "d139e37590437a49": {
      "count": 1,
      "topic": "Cats",
      "text": "A cat purrs at a frequency of about twenty-five to one hundred and fifty hertz.",
      "last_used": "2026-11-02T23:14:50.184044+00:00"
    },
    "4b5969f4f27aa741": {
      "count": 1,
      "topic": "Elephants",
      "text": "Elephants appear to show grief, and they sometimes gather around the bones of their dead relatives.",
      "last_used": "2026-11-02T23:14:50.184062+00:00"
    },
    "3cc178e915142839": {
      "count": 1,
      "topic": "Elephants",
      "text": "Elephants spend most of the day eating and can munch hundreds of pounds of plants every day.",
      "last_used": "2026-11-03T11:18:34.944532+00:00"
    },
    "494cd0b387749e58": {
      "count": 1,
      "topic": "Wolves",
      "text": "Every wolf has its own unique howl.",
      "last_used": "2026-11-03T11:18:34.944562+00:00"
    },
    "43f63fe463bd6681": {
      "count": 1,
      "topic": "Cats",
      "text": "A cat's nose print is unique, just like a human fingerprint.",
      "last_used": "2026-11-03T11:18:34.944571+00:00"
    },
    "9743a3228305f069": {
      "count": 1,
      "topic": "Whales",
      "text": "Many whales sleep with only half of their brain at a time, so they can keep breathing.",
      "last_used": "2026-11-03T17:35:12.084945+00:00"
    },
    "757456f1dc2b350b": {
      "count": 1,
      "topic": "Wolves",
      "text": "A hungry wolf can eat up to twenty pounds of meat in one meal.",
      "last_used": "2026-11-03T17:35:12.084979+00:00"
    },
    "318bee4ab4588e13": {
      "count": 1,
      "topic": "Cats",
      "text": "A cat's whiskers help it sense nearby objects and judge whether it can fit through a gap.",
      "last_used": "2026-11-03T17:35:12.084993+00:00"
    },
    "595a16c51acc9d04": {
      "count": 1,
      "topic": "Cats",
      "text": "The oldest known pet cat remains were found in Cyprus and are about nine thousand five hundred years old.",
      "last_used": "2026-11-03T21:26:33.650133+00:00"
    },
    "ce55507a7de97f7d": {
      "count": 1,
      "topic": "Wolves",
      "text": "A wolf pack is usually a family, made of parents and their young.",
      "last_used": "2026-11-03T21:26:33.650165+00:00"
    },
    "b445c441e001c0ff": {
      "count": 1,
      "topic": "Whales",
      "text": "Humpback whales sing long, complex songs that can travel for many miles underwater.",
      "last_used": "2026-11-03T21:26:33.650176+00:00"
    },
    "c9e9ec5d79880515": {
      "count": 1,
      "topic": "Whales",
      "text": "The tongue of a blue whale can weigh as much as an adult elephant.",
      "last_used": "2026-11-04T11:29:22.947675+00:00"
    },
    "ca227f6a9e6fd510": {
      "count": 1,
      "topic": "Wolves",
      "text": "Wolf pups are born deaf and blind, and they open their eyes after about two weeks.",
      "last_used": "2026-11-04T11:29:22.947705+00:00"
    },
    "86c551cc43ce59d0": {
      "count": 1,
      "topic": "Elephants",
      "text": "Elephants cannot jump, but they are surprisingly good swimmers.",
      "last_used": "2026-11-04T11:29:22.947715+00:00"
    },
    "42723e56eaa6e773": {
      "count": 1,
      "topic": "Elephants",
      "text": "Baby elephants suck on their trunks, just like human babies suck on their thumbs.",
      "last_used": "2026-11-04T17:37:13.489596+00:00"
    },
    "b138188db9c81da1": {
      "count": 1,
      "topic": "Cats",
      "text": "A group of cats is called a clowder.",
      "last_used": "2026-11-04T17:37:13.489621+00:00"
    },
    "06634caa6190476d": {
      "count": 1,
      "topic": "Whales",
      "text": "Blue whale calls can reach about one hundred eighty-eight decibels, among the loudest sounds made by any animal.",
      "last_used": "2026-11-04T17:37:13.489645+00:00"
    },
    "f1e0694503c88663": {
      "count": 1,
      "topic": "Wolves",
      "text": "A wolf can travel more than twenty miles in a single day.",
      "last_used": "2026-11-04T21:27:27.635467+00:00"
    },
    "0da4d8b7cf5c7ea1": {
      "count": 1,
      "topic": "Cats",
      "text": "Cats cannot taste sweetness, because they lack the receptor for it.",
      "last_used": "2026-11-04T21:27:27.635502+00:00"
    },
    "41a6acee506fe6e9": {
      "count": 1,
      "topic": "Whales",
      "text": "Bowhead whales can live for more than two hundred years.",
      "last_used": "2026-11-04T21:27:27.635519+00:00"
    },
    "6e8ac880971b6149": {
      "count": 1,
      "topic": "Whales",
      "text": "Killer whales, also called orcas, are actually the largest members of the dolphin family.",
      "last_used": "2026-11-05T11:28:43.766845+00:00"
    },
    "32b6f6fb4aa9843c": {
      "count": 1,
      "topic": "Cats",
      "text": "Cats have a field of view of about two hundred degrees.",
      "last_used": "2026-11-05T11:28:43.766881+00:00"
    },
    "bcd15678033f5bdb": {
      "count": 1,
      "topic": "Wolves",
      "text": "Wolves are the largest members of the dog family.",
      "last_used": "2026-11-05T11:28:43.766893+00:00"
    },
    "81bbca9f7c718204": {
      "count": 1,
      "topic": "Elephants",
      "text": "The largest tusk on record was about 3.5 meters long.",
      "last_used": "2026-11-08T10:43:56.917313+00:00"
    },
    "fc9077b5cb1747a5": {
      "count": 1,
      "topic": "Whales",
      "text": "A male whale is called a bull.",
      "last_used": "2026-11-08T10:43:56.917347+00:00"
    },
    "4e6357782df43b15": {
      "count": 1,
      "topic": "Cats",
      "text": "Kittens have 26 baby teeth.",
      "last_used": "2026-11-08T10:43:56.917363+00:00"
    },
    "1fb5671b550087e2": {
      "count": 1,
      "topic": "Whales",
      "text": "The earliest whale ancestors resembled small deer-like animals.",
      "last_used": "2026-11-08T16:16:03.464690+00:00"
    },
    "0199e4bbc95daa38": {
      "count": 1,
      "topic": "Cats",
      "text": "Cats can be affected by feline leukemia virus.",
      "last_used": "2026-11-08T16:16:03.464725+00:00"
    },
    "331a510f9f359037": {
      "count": 1,
      "topic": "Dogs",
      "text": "The first police dog program began in Ghent, Belgium in the 1890s.",
      "last_used": "2026-11-08T16:16:03.464746+00:00"
    },
    "fad6bd27619f6e3d": {
      "count": 1,
      "topic": "Whales",
      "text": "Baleen whales produce low-frequency sounds.",
      "last_used": "2026-11-08T19:53:15.204973+00:00"
    },
    "bc74105a6a7b3bd4": {
      "count": 1,
      "topic": "Cats",
      "text": "Cats can become pregnant as early as 4 months old.",
      "last_used": "2026-11-08T19:53:15.204999+00:00"
    },
    "2dece7aa4b9b1f49": {
      "count": 1,
      "topic": "Dogs",
      "text": "The Papillon's name means \"butterfly\" in French due to its ears.",
      "last_used": "2026-11-08T19:53:15.205009+00:00"
    },
    "ad0ebb79992c3d93": {
      "count": 1,
      "topic": "Elephants",
      "text": "Tourism based on elephant watching supports local economies.",
      "last_used": "2026-11-09T12:01:01.795029+00:00"
    },
    "c3d9496ddb270615": {
      "count": 1,
      "topic": "Dogs",
      "text": "Small dogs have faster heart rates than large dogs.",
      "last_used": "2026-11-09T12:01:01.795059+00:00"
    },
    "435710e7712b64d9": {
      "count": 1,
      "topic": "Cats",
      "text": "Cats make a trilling sound to greet each other.",
      "last_used": "2026-11-09T12:01:01.795072+00:00"
    },
    "5ca67de358e028b4": {
      "count": 1,
      "topic": "Elephants",
      "text": "Elephants can eat the fruit of the marula tree.",
      "last_used": "2026-11-09T20:00:16.150094+00:00"
    },
    "007d5634e3bbc9ee": {
      "count": 1,
      "topic": "Whales",
      "text": "Humpbacks have been seen protecting other animals from killer whales.",
      "last_used": "2026-11-09T20:00:16.150134+00:00"
    },
    "245d3600f270842f": {
      "count": 1,
      "topic": "Cats",
      "text": "Larry is the chief mouser of 10 Downing Street.",
      "last_used": "2026-11-09T20:00:16.150144+00:00"
    },
    "45bf45952134199e": {
      "count": 1,
      "topic": "Whales",
      "text": "Sperm whales have the loudest sound of any animal.",
      "last_used": "2026-11-09T23:51:53.544691+00:00"
    },
    "8aa80299b863f107": {
      "count": 1,
      "topic": "Elephants",
      "text": "The international ivory trade was banned in 1989.",
      "last_used": "2026-11-09T23:51:53.544725+00:00"
    },
    "940245d9caeaf711": {
      "count": 1,
      "topic": "Dogs",
      "text": "Neutering can reduce certain health risks and roaming behavior.",
      "last_used": "2026-11-09T23:51:53.544742+00:00"
    },
    "57f881c5594d02d1": {
      "count": 1,
      "topic": "Cats",
      "text": "High-rise syndrome describes injuries cats get from falling from high places.",
      "last_used": "2026-11-10T11:39:24.051834+00:00"
    },
    "452e1bc760d5c6ee": {
      "count": 1,
      "topic": "Elephants",
      "text": "Elephant sanctuaries provide care for rescued animals.",
      "last_used": "2026-11-10T11:39:24.051865+00:00"
    },
    "b6242bdc2fe8729c": {
      "count": 1,
      "topic": "Whales",
      "text": "Each whale species has a distinct blow shape.",
      "last_used": "2026-11-10T11:39:24.051879+00:00"
    },
    "50268b5623152390": {
      "count": 1,
      "topic": "Whales",
      "text": "Female orcas go through menopause.",
      "last_used": "2026-11-10T17:15:45.548868+00:00"
    },
    "881de3effd79901c": {
      "count": 1,
      "topic": "Dogs",
      "text": "The Irish Wolfhound is among the tallest dog breeds.",
      "last_used": "2026-11-10T17:15:45.548899+00:00"
    },
    "586ff1726983d16f": {
      "count": 1,
      "topic": "Cats",
      "text": "Cats can get hairballs from swallowing fur during grooming.",
      "last_used": "2026-11-10T17:15:45.548907+00:00"
    },
    "ece9ea5c91ee1bcf": {
      "count": 1,
      "topic": "Dogs",
      "text": "Dogs are the most popular pet in many countries.",
      "last_used": "2026-11-10T21:24:37.113570+00:00"
    },
    "a3228941246366c7": {
      "count": 1,
      "topic": "Elephants",
      "text": "Elephants have a strong sense of family.",
      "last_used": "2026-11-10T21:24:37.113607+00:00"
    },
    "1f3ccf9790bf152e": {
      "count": 1,
      "topic": "Cats",
      "text": "A cat showing its belly may be relaxed, not necessarily asking for a rub.",
      "last_used": "2026-11-10T21:24:37.113627+00:00"
    },
    "7b8a3f108036bf8b": {
      "count": 1,
      "topic": "Elephants",
